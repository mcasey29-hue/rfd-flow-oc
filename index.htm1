DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>RFD Flow OC | Local Services</title>
<style>
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:Arial,sans-serif;background:#f4f7f6;color:#172033}
header,footer{background:#101010;color:white;text-align:center;padding:30px 15px}
header h1{color:#65e52c;font-size:36px;margin:0}
nav{background:white;text-align:center;padding:18px}
nav a{color:#172033;text-decoration:none;font-weight:bold;margin:10px}
.hero{background:linear-gradient(135deg,#101010,#234b24);color:white;text-align:center;padding:70px 20px}
.hero h2{font-size:36px}
button,.btn{display:inline-block;background:#65e52c;color:#101010;border:0;border-radius:8px;padding:14px 22px;margin:8px;font-weight:bold;cursor:pointer;text-decoration:none}
button:hover,.btn:hover{background:#50c91c}
section{max-width:1100px;margin:auto;padding:45px 20px}
section h2{text-align:center}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px;margin-top:25px}
.card,.form-box{background:white;padding:25px;border-radius:12px;box-shadow:0 4px 15px #00000012}
.card{text-align:center}
.card h3{color:#234b24}
.form-box{max-width:600px;margin:auto}
input,select,textarea{width:100%;padding:13px;margin:10px 0;border:1px solid #ccc;border-radius:7px;font:inherit}
label{font-weight:bold}
#message{color:#234b24;font-weight:bold}
footer h2{color:#65e52c}
</style>
</head>
<body>
<header>
<h1>RFD FLOW OC</h1>
<p>Connecting Orange County</p>
